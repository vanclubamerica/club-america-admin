# =============================================================================
# Club America Admin — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. See docs/01-supabase-setup.md for where each
# value comes from.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# -----------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a client component. Treat this like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# GitHub sync  (docs/02-github-setup.md)
# -----------------------------------------------------------------------------
# Fine-grained personal access token, scoped to ONLY the public site repo,
# with "Contents: Read and write" permission. No other scopes.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# The public website repository that published content is committed to.
GITHUB_OWNER=vanclubamerica
GITHUB_REPO=clubamerica

# Branch to publish to. Use a test branch (e.g. `cms-test`) while verifying,
# then switch to `main` once you have confirmed the diffs look right.
GITHUB_TARGET_BRANCH=main

# Shown in the commit author field of automated commits.
GITHUB_COMMIT_AUTHOR_NAME=Club America Admin
GITHUB_COMMIT_AUTHOR_EMAIL=admin@tpvan.com

# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tpvan.com
NEXT_PUBLIC_ADMIN_URL=https://admin.tpvan.com

# -----------------------------------------------------------------------------
# Google Calendar (optional)
# -----------------------------------------------------------------------------
# Public calendar ID — read via the public .ics feed, so NO API key or billing
# is required. Leave blank to fall back to manually entered events.
GOOGLE_CALENDAR_ID=d2827c50efa645a951222bb4cc6d6c2ef61e0941b845576ab323123e084c4073@group.calendar.google.com

# -----------------------------------------------------------------------------
# Email notifications (optional — leave blank to disable)
# -----------------------------------------------------------------------------
# Free tier at https://resend.com. When RESEND_API_KEY is empty, notifications
# are logged to the audit trail but no email is sent.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=admin@tpvan.com

# -----------------------------------------------------------------------------
# Technical contact (shown in the admin footer)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_NAME=Brant Borden
NEXT_PUBLIC_SUPPORT_EMAIL=brsnt3@gmail.com
